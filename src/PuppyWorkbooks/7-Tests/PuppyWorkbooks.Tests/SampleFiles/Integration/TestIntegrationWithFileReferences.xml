<?xml version="1.0" encoding="utf-8"?>
<Integration Name="Sales total"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../../../../3-Services/PuppyWorkbooks.Integration/Schemas/Integration.xsd">

<Steps>
        <CsvInput Id="input" FilePath="__INPUT_PATH__"/>
        <Map Id="map">
            <Worksheet FilePath="Map.xml"/>
        </Map>
        <Filter Id="filter">
            <Worksheet FilePath="Filter.xml"/>
        </Filter>
        <Reduce Id="reduce" OutputField="Total">
            <InitialStateJson>0</InitialStateJson>
            <Worksheet FilePath="Reduce.xml"/>
        </Reduce>
        <CsvOutput Id="output" FilePath="__OUTPUT_PATH__"/>
    </Steps>
</Integration>
